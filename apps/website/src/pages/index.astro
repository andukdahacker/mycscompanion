---
import Base from '../layouts/Base.astro'
import { Code } from 'astro:components'
import fs from 'node:fs'
import path from 'node:path'
import yaml from 'yaml'

// --- Build-time content loading from content/milestones/01-kv-store/ ---
const contentDir = path.resolve('../../content/milestones/01-kv-store')

// Read and parse brief.md
const briefRaw = fs.readFileSync(path.join(contentDir, 'brief.md'), 'utf-8')

// Extract "What You're Building" summary (first paragraph after heading)
const buildingMatch = briefRaw.match(/## What You're Building\n\n(.+?\n\n)/s)
const buildingSummary = buildingMatch
  ? buildingMatch[1].trim().split('\n')[0].replace(/`([^`]+)`/g, '$1')
  : ''

// Extract "What You'll Learn" bullet points
const learnSection = briefRaw.match(/## What You'll Learn\n\n([\s\S]*?)(?=\n##|\n---|$)/)?.[1] ?? ''
const learningObjectives = learnSection
  .split('\n')
  .filter((line: string) => line.startsWith('- **'))
  .map((line: string) => {
    const match = line.match(/- \*\*(.+?)\*\* — (.+)/)
    return match ? { title: match[1], description: match[2].replace(/`([^`]+)`/g, '$1') } : null
  })
  .filter((obj): obj is { title: string; description: string } => obj !== null)

// Read starter code and extract excerpt (struct + Get/Put/Delete signatures with TODOs)
const starterCode = fs.readFileSync(path.join(contentDir, 'starter-code/main.go'), 'utf-8')
const starterLines = starterCode.split('\n')
// KVStore struct (lines 15-20, 0-indexed 14-19)
const structLines = starterLines.slice(14, 20)
// Get method (lines 58-70, 0-indexed 57-69)
const getLines = starterLines.slice(57, 70)
// Put method (lines 72-84, 0-indexed 71-83)
const putLines = starterLines.slice(71, 84)
// Delete method (lines 86-98, 0-indexed 85-97)
const deleteLines = starterLines.slice(85, 98)
const goExcerpt = [
  ...structLines,
  '',
  '// ...',
  '',
  ...getLines,
  '',
  ...putLines,
  '',
  ...deleteLines,
].join('\n')

// CTA class string — shared across all 4 CTA links for DRY hover/focus styling
const ctaClasses = 'inline-flex items-center justify-center bg-primary text-primary-foreground font-semibold rounded-lg min-h-[44px] min-w-[44px] px-8 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:bg-primary/90 transition-colors'

// Read and parse acceptance criteria YAML
const criteriaRaw = fs.readFileSync(path.join(contentDir, 'acceptance-criteria.yaml'), 'utf-8')
const parsed = yaml.parse(criteriaRaw)
const criteria = parsed.criteria.map((c: { name: string; description: string }) => ({
  name: c.name,
  description: c.description,
}))
---

<Base
  title="tycs — Learn CS by Building"
  description="Master computer science fundamentals by building real systems in Go. Write a key-value store, measure it against a reference implementation, iterate until yours is faster."
>
  <section aria-labelledby="hero-heading" class="py-16 lg:py-24 px-6 md:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <h1
        id="hero-heading"
        class="text-display font-bold text-foreground leading-tight max-w-3xl mx-auto"
      >
        Build a database. Learn computer science.
      </h1>
      <p class="mt-6 text-body text-muted-foreground max-w-[720px] mx-auto">
        Write real code. Watch your system improve across 5 milestones. Guided by AI, benchmarked against real implementations.
      </p>
      <figure class="mt-10">
        <pre class="font-mono text-code-block text-foreground bg-card rounded-lg border border-border p-6 text-left max-w-xl mx-auto overflow-x-auto"><code>func (kv *KVStore) Put(key string, value []byte) error {'{'}
    kv.mu.Lock()
    defer kv.mu.Unlock()

    kv.store[key] = value
    return kv.flushToDisk(key, value)
{'}'}</code></pre>
        <figcaption class="sr-only">Example KVStore.Put function from Milestone 1</figcaption>
      </figure>
      <p class="mt-4 font-mono text-body text-muted-foreground">
        -&gt; 25,412 inserts/sec
      </p>
      <div class="mt-10">
        <a
          href="https://app.mycscompanion.dev/sign-in"
          class={ctaClasses}
        >
          <span class="hidden md:inline">Start Building</span>
          <span class="md:hidden">Open on desktop to build</span>
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="roadmap-heading" class="py-16 lg:py-24 px-6 md:px-8">
    <div class="max-w-7xl mx-auto">
      <h2
        id="roadmap-heading"
        class="text-h1 font-semibold text-foreground text-center"
      >
        Five milestones. One database. Seven CS subjects.
      </h2>
      <div class="mt-12 flex flex-col gap-6 lg:gap-8 max-w-3xl mx-auto">
        <article aria-labelledby="milestone-1" class="bg-card rounded-lg p-6 border border-border">
          <h3 id="milestone-1" class="text-h2 font-semibold text-foreground">Milestone 1: Key-Value Store</h3>
          <p class="mt-3 text-body text-muted-foreground">
            Implement <code>Get</code>, <code>Put</code>, <code>Delete</code> with disk persistence. Handle concurrent access.
          </p>
          <p class="mt-2 text-body-sm text-muted-foreground">
            CS concepts: Hash maps, file I/O, serialization
          </p>
          <p class="mt-2"><span class="inline-block bg-background rounded px-2 py-0.5 text-body-sm text-muted-foreground">80% scaffolded</span></p>
        </article>
        <article aria-labelledby="milestone-2" class="bg-card rounded-lg p-6 border border-border">
          <h3 id="milestone-2" class="text-h2 font-semibold text-foreground">Milestone 2: Storage Engine</h3>
          <p class="mt-3 text-body text-muted-foreground">
            Add a write-ahead log for crash recovery. Implement compaction.
          </p>
          <p class="mt-2 text-body-sm text-muted-foreground">
            CS concepts: Write-ahead logging, crash recovery, log-structured storage
          </p>
          <p class="mt-2"><span class="inline-block bg-background rounded px-2 py-0.5 text-body-sm text-muted-foreground">~60% scaffolded</span></p>
        </article>
        <article aria-labelledby="milestone-3" class="bg-card rounded-lg p-6 border border-border">
          <h3 id="milestone-3" class="text-h2 font-semibold text-foreground">Milestone 3: B-Tree Indexing</h3>
          <p class="mt-3 text-body text-muted-foreground">
            Build a B-tree index. Implement node splits and range scans.
          </p>
          <p class="mt-2 text-body-sm text-muted-foreground">
            CS concepts: Tree data structures, disk-based indexing, range queries
          </p>
          <p class="mt-2"><span class="inline-block bg-background rounded px-2 py-0.5 text-body-sm text-muted-foreground">40% scaffolded</span></p>
        </article>
        <article aria-labelledby="milestone-4" class="bg-card rounded-lg p-6 border border-border">
          <h3 id="milestone-4" class="text-h2 font-semibold text-foreground">Milestone 4: Query Parser</h3>
          <p class="mt-3 text-body text-muted-foreground">
            Parse and execute SQL queries against your storage engine.
          </p>
          <p class="mt-2 text-body-sm text-muted-foreground">
            CS concepts: Lexing, parsing, query planning, abstract syntax trees
          </p>
          <p class="mt-2"><span class="inline-block bg-background rounded px-2 py-0.5 text-body-sm text-muted-foreground">~20% scaffolded</span></p>
        </article>
        <article aria-labelledby="milestone-5" class="bg-card rounded-lg p-6 border border-border">
          <h3 id="milestone-5" class="text-h2 font-semibold text-foreground">Milestone 5: ACID Transactions</h3>
          <p class="mt-3 text-body text-muted-foreground">
            Add transactional semantics with rollback and durability guarantees.
          </p>
          <p class="mt-2 text-body-sm text-muted-foreground">
            CS concepts: Concurrency control, isolation levels, write-ahead log recovery
          </p>
          <p class="mt-2"><span class="inline-block bg-background rounded px-2 py-0.5 text-body-sm text-muted-foreground">~15% scaffolded</span></p>
        </article>
      </div>
      <div class="mt-12 text-center">
        <a
          href="https://app.mycscompanion.dev/sign-in"
          class={ctaClasses}
        >
          <span class="hidden md:inline">Start Building</span>
          <span class="md:hidden">Open on desktop to build</span>
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="preview-heading" class="py-16 lg:py-24 px-6 md:px-8">
    <div class="max-w-3xl mx-auto">
      <h2
        id="preview-heading"
        class="text-h1 font-semibold text-foreground text-center"
      >
        Milestone 1: Key-Value Store
      </h2>
      <p class="mt-4 text-body text-muted-foreground text-center">
        {buildingSummary}
      </p>

      <h3 class="mt-10 text-h2 font-semibold text-foreground">What You'll Learn</h3>
      <ul class="mt-4 space-y-3 text-body text-muted-foreground">
        {learningObjectives.map((obj) => (
          <li>
            <span class="text-foreground font-semibold">{obj.title}</span> — {obj.description}
          </li>
        ))}
      </ul>

      <h3 class="mt-10 text-h2 font-semibold text-foreground">Starter Code</h3>
      <div class="mt-4 rounded-lg border border-border overflow-y-hidden overflow-x-auto">
        <Code code={goExcerpt} lang="go" theme="github-dark" />
      </div>
      <p class="mt-3 text-body text-muted-foreground">
        80% scaffolded. Your job: implement the TODO functions.
      </p>

      <h3 class="mt-10 text-h2 font-semibold text-foreground">Acceptance Criteria</h3>
      <ol class="mt-4 space-y-3 list-decimal list-inside">
        {criteria.map((c: { name: string; description: string }) => (
          <li class="text-body text-muted-foreground">
            <span class="text-foreground font-semibold">{c.name}</span> — {c.description}
          </li>
        ))}
      </ol>

      <p class="mt-6 font-mono text-body text-muted-foreground">
        Results: 1,000 inserts, avg 39.12ms, 25,412 ops/sec
      </p>

      <div class="mt-10 text-center">
        <a
          href="https://app.mycscompanion.dev/sign-in"
          class={ctaClasses}
        >
          <span class="hidden md:inline">Sign Up to Build</span>
          <span class="md:hidden">Open on desktop to build</span>
        </a>
      </div>
    </div>
  </section>

  <div slot="footer" class="max-w-7xl mx-auto px-6 md:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-body-sm text-muted-foreground">
        tycs — Computer science through implementation
      </p>
      <a
        href="https://app.mycscompanion.dev/sign-in"
        class={ctaClasses}
      >
        <span class="hidden md:inline">Start Building</span>
        <span class="md:hidden">Open on desktop to build</span>
      </a>
    </div>
    <div class="mt-8 pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-caption text-muted-foreground">
        &copy; {new Date().getFullYear()} tycs
      </p>
      <nav aria-label="Footer navigation">
        <a
          href="https://app.mycscompanion.dev/privacy"
          class="text-caption text-muted-foreground hover:text-foreground transition-colors"
        >
          Privacy Policy
        </a>
      </nav>
    </div>
  </div>
</Base>
