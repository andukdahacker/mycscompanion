{
  "name": "@mycscompanion/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "postinstall": "test -f src/types/db.ts || printf '/** Stub — run: pnpm --filter shared db:types */\\n// eslint-disable-next-line @typescript-eslint/no-empty-object-type\\nexport interface DB {}\\n' > src/types/db.ts",
    "db:types": "dotenv -e ../../.env -- kysely-codegen --dialect postgres --out-file ./src/types/db.ts",
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "kysely": "^0.28.12",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
